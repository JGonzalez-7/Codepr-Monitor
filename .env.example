# Copy to .env and fill in. .env is gitignored.

# --- Core ---------------------------------------------------------------
# Signs session cookies. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=codepr

# Local dev without Docker can point at SQLite instead:
# DATABASE_URL=sqlite:///./codepr_monitor.db

# --- Monitoring ---------------------------------------------------------
CHECK_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=15

# The live HBPR site. Change this to re-point the check at a different host.
HBPR_URL=https://holbertonschoolpr.com/

# --- Ticket screenshots --------------------------------------------------
# Attachments are stored in the database, so these also bound how fast the
# Postgres volume grows.
MAX_ATTACHMENT_MB=5
MAX_ATTACHMENTS_PER_TICKET=3

# --- Cloudflare Access (odoo.code.pr) -----------------------------------
# odoo.code.pr sits behind Cloudflare Zero Trust. Without a service token every
# check just sees the Access login redirect, which says nothing about Odoo.
# Create one in Cloudflare Zero Trust > Access > Service Auth, then add it to
# the odoo.code.pr application policy with a "Service Auth" include rule.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# --- Uptime Kuma --------------------------------------------------------
# URL the admin dashboard embeds. A public status page (e.g. .../status/codepr)
# embeds most reliably; the full dashboard requires its own login inside the frame.
UPTIME_KUMA_EMBED_URL=http://localhost:3001

# --- Odoo push ----------------------------------------------------------
# Tickets are mirrored into Odoo via XML-RPC using the codepr_monitor addon.
ODOO_ENABLED=false
ODOO_URL=https://odoo.code.pr
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=

# --- Seed accounts ------------------------------------------------------
# Passwords for the seeded accounts (admin, and user1/user2/user3).
#
# Set these explicitly. Nothing writes credentials into the container, so if you
# leave them blank the Docker stack generates random passwords you cannot read
# back. With them set, the accounts are the same however you run the app.
#
# Running locally (no Docker) also writes them to SECRETS.md at the repo root,
# which is gitignored.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
